#!/usr/bin/env bash
#
# veeros-vm — VeerOS VM orchestration tool
#
# Manage multiple persistent VeerOS QEMU virtual machines with
# unique hostnames, SSH ports, disks, and lifecycle control.
#
# Usage:
#   veeros-vm create <name> [options]     Create a new VM
#     --target x86_64|esp32c6            Target architecture
#     --net nat|bridge|user              Network backend
#       nat    — QEMU user-net with hostfwd (x86_64 / esp32c6)
#       bridge — virtio-net TAP bridge (Linux)
#       user   — veer-vm user-net, no root (esp32c6 VirtualIoT, macOS)
#   veeros-vm start <name>                Start a VM
#   veeros-vm stop <name>                 Stop a VM (graceful)
#   veeros-vm kill <name>                 Force-kill a VM
#   veeros-vm restart <name>              Stop + start
#   veeros-vm status [name]               Show VM status(es)
#   veeros-vm list                        List all VMs
#   veeros-vm ssh <name> [cmd...]         SSH into a VM
#   veeros-vm console <name>              Attach to serial console
#   veeros-vm destroy <name>              Remove a VM and its data
#   veeros-vm config <name>               Show VM configuration
#   veeros-vm set <name> key=value ...    Update VM settings
#   veeros-vm logs <name>                 Show VM serial log
#   veeros-vm build                       Rebuild the kernel ISO
#   veeros-vm ip <name>                   Show SSH connection info
#   veeros-vm volume create <name>        Create a persistent volume
#   veeros-vm volume list                 List volumes
#   veeros-vm volume attach <vm> <vol>    Attach volume to VM
#   veeros-vm volume detach <vm> <vol>    Detach volume from VM
#   veeros-vm volume delete <name>        Delete a volume
#   veeros-vm sensor list <vm>            List virtual sensors (esp32c6)
#   veeros-vm sensor inject <vm> <s> <v>  Inject sensor reading (esp32c6)
#
# VM state is persisted under ~/.veeros/vms/<name>/
# Volumes are stored under ~/.veeros/volumes/

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────
# When run via sudo, use the invoking user's home (SUDO_USER).
_REAL_HOME="${HOME}"
if [ -n "${SUDO_USER:-}" ]; then
    _REAL_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
fi
VEEROS_HOME="${VEEROS_HOME:-${_REAL_HOME}/.veeros}"
VEEROS_VMS="$VEEROS_HOME/vms"
VEEROS_VOLUMES="$VEEROS_HOME/volumes"
VEEROS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VEEROS_ISO="$VEEROS_ROOT/build/veeros.iso"
VEEROS_ESP32C6_ELF="$VEEROS_ROOT/target/riscv32imc-unknown-none-elf/release/kernel-qemu-esp32c6"
VEEROS_ESP32C6_DEBUG_ELF="$VEEROS_ROOT/target/riscv32imc-unknown-none-elf/debug/kernel-qemu-esp32c6"

# Ensure base dirs exist
mkdir -p "$VEEROS_VMS" "$VEEROS_VOLUMES"

PORT_LOCK_DIR=""

# ── Network constants ────────────────────────────────────────────────
VEEROS_BRIDGE="veeros0"
VEEROS_BRIDGE_PHYS="$VEEROS_HOME/bridge_phys"
VEEROS_BRIDGE_HOST_CIDR="$VEEROS_HOME/bridge_host_cidr"
VEEROS_BRIDGE_HOST_GW="$VEEROS_HOME/bridge_host_gw"

# ── Helpers ──────────────────────────────────────────────────────────

die() { echo "error: $*" >&2; exit 1; }
warn() { echo "warn: $*" >&2; }

cleanup_locks() {
    if [ -n "${PORT_LOCK_DIR:-}" ] && [ -d "$PORT_LOCK_DIR" ]; then
        rmdir "$PORT_LOCK_DIR" 2>/dev/null || true
    fi
}
trap cleanup_locks EXIT

vm_dir() { echo "$VEEROS_VMS/$1"; }

vm_exists() { [ -f "$(vm_dir "$1")/vm.conf" ]; }

vm_pid_file() { echo "$(vm_dir "$1")/qemu.pid"; }

vm_log_file() { echo "$(vm_dir "$1")/serial.log"; }

vm_disk_file() { echo "$(vm_dir "$1")/disk.img"; }

vm_system_disk() { echo "$(vm_dir "$1")/system.img"; }

vm_is_running() {
    local pf pid
    pf="$(vm_pid_file "$1")"
    [ -f "$pf" ] || return 1
    pid=$(cat "$pf" 2>/dev/null) || return 1
    # Portable check for Linux/macOS. kill -0 works for same-user processes
    # (the default for user/net mode on macOS).
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

cleanup_orphan_vm_runtime() {
    local name="$1"
    command -v pgrep >/dev/null 2>&1 || return 0

    local pids=""
    local by_name by_path
    by_name=$(pgrep -f "veeros-${name}" 2>/dev/null || true)
    by_path=$(pgrep -f "${VEEROS_VMS}/${name}/" 2>/dev/null || true)
    pids="${by_name}
${by_path}"

    local pid cmd
    for pid in $pids; do
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
        case "$cmd" in
            *qemu-system*|*veer-vm*)
                warn "cleaning orphan VM runtime pid=$pid for '$name'"
                kill "$pid" 2>/dev/null || true
                sleep 0.2
                kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
                ;;
        esac
    done
}

# Read a VM config value
vm_get() {
    local name="$1" key="$2"
    { grep "^${key}=" "$(vm_dir "$name")/vm.conf" 2>/dev/null || true; } | head -1 | cut -d= -f2-
}

# Write/update a VM config value
vm_set() {
    local name="$1" key="$2" val="$3"
    local conf
    conf="$(vm_dir "$name")/vm.conf"
    if grep -q "^${key}=" "$conf" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$conf"
    else
        echo "${key}=${val}" >> "$conf"
    fi
}

port_is_listening() {
    local port="$1"
    if command -v nc >/dev/null 2>&1; then
        nc -z 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
    fi
    if command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 && return 0
    fi
    return 1
}

acquire_port_lock() {
    local lock="$VEEROS_HOME/.ssh-port.lock"
    local tries=0
    while ! mkdir "$lock" 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -gt 200 ]; then
            die "timed out acquiring SSH/shell port lock"
        fi
        sleep 0.05
    done
    PORT_LOCK_DIR="$lock"
}

release_port_lock() {
    if [ -n "${PORT_LOCK_DIR:-}" ] && [ -d "$PORT_LOCK_DIR" ]; then
        rmdir "$PORT_LOCK_DIR" 2>/dev/null || true
    fi
    PORT_LOCK_DIR=""
}

format_vfat_image() {
    local image="$1" label="$2"
    if command -v mkfs.vfat >/dev/null 2>&1; then
        mkfs.vfat -F 32 -n "$label" "$image" >/dev/null 2>&1 \
            || warn "mkfs.vfat failed for '$image'; continuing"
    elif command -v mkfs.fat >/dev/null 2>&1; then
        mkfs.fat -F 32 -n "$label" "$image" >/dev/null 2>&1 \
            || warn "mkfs.fat failed for '$image'; continuing"
    elif command -v newfs_msdos >/dev/null 2>&1; then
        newfs_msdos -F 32 -v "$label" "$image" >/dev/null 2>&1 \
            || warn "newfs_msdos failed for '$image'; continuing"
    else
        warn "no FAT formatter found (mkfs.vfat/mkfs.fat/newfs_msdos); leaving '$image' unformatted"
    fi
}

# Find next available SSH port (starting from 2230)
next_ssh_port() {
    local port=2230
    while true; do
        local used=false
        for d in "$VEEROS_VMS"/*/vm.conf; do
            [ -f "$d" ] || continue
            local p
            p=$(grep "^ssh_port=" "$d" 2>/dev/null | cut -d= -f2-)
            if [ "$p" = "$port" ]; then
                used=true
                break
            fi
        done
        if ! $used && ! port_is_listening "$port"; then
            echo "$port"
            return
        fi
        port=$((port + 1))
        if [ "$port" -gt 2300 ]; then
            die "no available SSH ports in range 2230-2300"
        fi
    done
}

validate_name() {
    [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "invalid VM name '$1' (use alphanumeric, hyphens, dots)"
    [ ${#1} -le 63 ] || die "VM name too long (max 63 chars)"
}

# ── VeerOS Network (bridge + DHCP) ──────────────────────────────────

# Check if the veeros0 bridge is up
_net_is_up() {
    ip link show "$VEEROS_BRIDGE" >/dev/null 2>&1
}

# Ensure running as root for network operations
_require_root() {
    [ "$(id -u)" -eq 0 ] || die "$1 requires root (use sudo)"
}

# Find the default internet-facing interface for NAT masquerade
_default_iface() {
    ip route show default 2>/dev/null | awk '/default/ {print $5; exit}'
}

# Set up the veeros0 bridge, bridging the physical NIC so VMs
# appear on the external LAN and get DHCP from the router.
_net_setup() {
    _require_root "network setup"

    if _net_is_up; then
        echo "veeros network already up ($VEEROS_BRIDGE)"
        return 0
    fi

    # Find the default physical interface
    local phys
    phys=$(_default_iface)
    [ -n "$phys" ] || die "no default network interface found"

    # Capture current IP and gateway before touching anything
    local host_cidr host_gw
    host_cidr=$(ip -4 -o addr show "$phys" | awk '{print $4}' | head -1)
    host_gw=$(ip -4 route show default dev "$phys" | awk '{print $3; exit}')
    [ -n "$host_cidr" ] || die "cannot determine IP of $phys"
    [ -n "$host_gw" ]   || die "cannot determine gateway via $phys"

    echo "Creating bridge $VEEROS_BRIDGE (bridging $phys to physical LAN)..."

    # Create bridge and attach the physical NIC
    ip link add "$VEEROS_BRIDGE" type bridge
    ip link set "$VEEROS_BRIDGE" up
    ip link set "$phys" master "$VEEROS_BRIDGE"

    # Move host IP from physical NIC to bridge
    ip addr flush dev "$phys"
    ip addr add "$host_cidr" dev "$VEEROS_BRIDGE"
    ip route add default via "$host_gw" dev "$VEEROS_BRIDGE" 2>/dev/null || true

    # Enable IP forwarding
    sysctl -q net.ipv4.ip_forward=1

    # Save original config for teardown
    echo "$phys"      > "$VEEROS_BRIDGE_PHYS"
    echo "$host_cidr" > "$VEEROS_BRIDGE_HOST_CIDR"
    echo "$host_gw"   > "$VEEROS_BRIDGE_HOST_GW"

    echo "veeros network ready (VMs get DHCP from physical LAN)"
}

# Tear down the veeros0 bridge and restore physical NIC config
_net_teardown() {
    _require_root "network teardown"

    # Check for running VMs using the bridge
    local running=0
    for d in "$VEEROS_VMS"/*/vm.conf; do
        [ -f "$d" ] || continue
        local n
        n=$(basename "$(dirname "$d")")
        local nm
        nm=$(vm_get "$n" net_mode)
        local br
        br=$(vm_get "$n" bridge)
        if [ "$nm" = "bridge" ] && [ "$br" = "$VEEROS_BRIDGE" ] && vm_is_running "$n"; then
            running=$((running + 1))
        fi
    done
    if [ "$running" -gt 0 ]; then
        die "$running VM(s) still running on $VEEROS_BRIDGE — stop them first"
    fi

    if _net_is_up; then
        # Read saved config
        local phys host_cidr host_gw
        phys=$(cat "$VEEROS_BRIDGE_PHYS" 2>/dev/null || true)
        host_cidr=$(cat "$VEEROS_BRIDGE_HOST_CIDR" 2>/dev/null || true)
        host_gw=$(cat "$VEEROS_BRIDGE_HOST_GW" 2>/dev/null || true)

        # Remove physical NIC from bridge
        if [ -n "$phys" ]; then
            ip link set "$phys" nomaster 2>/dev/null || true
        fi

        ip link set "$VEEROS_BRIDGE" down 2>/dev/null || true
        ip link delete "$VEEROS_BRIDGE" 2>/dev/null || true

        # Restore host IP on physical NIC
        if [ -n "$phys" ] && [ -n "$host_cidr" ]; then
            ip addr add "$host_cidr" dev "$phys" 2>/dev/null || true
            if [ -n "$host_gw" ]; then
                ip route add default via "$host_gw" dev "$phys" 2>/dev/null || true
            fi
        fi

        rm -f "$VEEROS_BRIDGE_PHYS" "$VEEROS_BRIDGE_HOST_CIDR" "$VEEROS_BRIDGE_HOST_GW"
    fi

    echo "veeros network stopped"
}

_net_status() {
    if _net_is_up; then
        local phys
        phys=$(cat "$VEEROS_BRIDGE_PHYS" 2>/dev/null || echo "?")
        local bridge_ip
        bridge_ip=$(ip -4 -o addr show "$VEEROS_BRIDGE" 2>/dev/null | awk '{print $4}' | head -1)
        echo "Network:  UP"
        echo "Bridge:   $VEEROS_BRIDGE"
        echo "Physical: $phys"
        echo "Host IP:  ${bridge_ip:-unknown}"
        echo "Mode:     LAN bridge (VMs get DHCP from router)"
        # Show bridge members
        local members
        members=$(bridge link show dev "$VEEROS_BRIDGE" 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
        if [ -n "$members" ]; then
            echo "Members:  $members"
        fi
    else
        echo "Network:  DOWN"
        echo ""
        echo "Start with: sudo veeros-vm network setup"
    fi
}

# Create TAP for a VM and attach to bridge
_tap_create() {
    local name="$1"
    local tap="tap-${name}"
    ip link delete "$tap" 2>/dev/null || true
    ip tuntap add dev "$tap" mode tap
    ip link set "$tap" up
    ip link set "$tap" master "$VEEROS_BRIDGE"
}

# Remove TAP for a VM
_tap_destroy() {
    local name="$1"
    local tap="tap-${name}"
    ip link delete "$tap" 2>/dev/null || true
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_create() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm create <name> [--target x86_64|esp32c6] [--memory MB] [--disk SIZE] [--ssh-port PORT] [--net nat|bridge|user] [--bridge BR]"
    validate_name "$name"
    vm_exists "$name" && die "VM '$name' already exists"
    shift

    # Defaults
    local target="x86_64"
    local memory=256
    local disk_size="64M"
    local ssh_port=""
    local net_mode="bridge"
    local bridge="$VEEROS_BRIDGE"
    local hostname="VeerOS"

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --target)   target="${2:?--target requires value}"; shift 2 ;;
            --memory)   memory="${2:?--memory requires value}"; shift 2 ;;
            --disk)     disk_size="${2:?--disk requires value}"; shift 2 ;;
            --ssh-port) ssh_port="${2:?--ssh-port requires value}"; shift 2 ;;
            --net)      net_mode="${2:?--net requires value}"; shift 2 ;;
            --bridge)   bridge="${2:?--bridge requires value}"; shift 2 ;;
            --hostname) hostname="${2:?--hostname requires value}"; shift 2 ;;
            *)          die "unknown option: $1" ;;
        esac
    done

    # Validate target
    case "$target" in
        x86_64|esp32c6) ;;
        *) die "invalid target '$target' (use x86_64 or esp32c6)" ;;
    esac
    case "$net_mode" in
        nat|bridge|user) ;;
        *) die "invalid --net '$net_mode' (use nat, bridge, or user)" ;;
    esac

    # Apply target defaults
    if [ "$target" = "esp32c6" ]; then
        [ "$memory" != "256" ] || memory=128  # default 128M for esp32c6
        [ "$hostname" != "VeerOS" ] || hostname="veeros-esp32c6"
    fi

    # Serialize ssh/shell port selection so concurrent creates don't collide.
    acquire_port_lock

    # Auto-assign SSH/shell port if not specified.
    if [ -z "$ssh_port" ]; then
        ssh_port=$(next_ssh_port)
    else
        for d in "$VEEROS_VMS"/*/vm.conf; do
            [ -f "$d" ] || continue
            local p
            p=$(grep "^ssh_port=" "$d" 2>/dev/null | cut -d= -f2-)
            if [ "$p" = "$ssh_port" ]; then
                release_port_lock
                die "SSH/shell port '$ssh_port' is already assigned to another VM"
            fi
        done
        if port_is_listening "$ssh_port"; then
            release_port_lock
            die "SSH/shell port '$ssh_port' is already in use on host"
        fi
    fi

    # Validate net mode
    case "$net_mode" in
        nat|bridge) ;;
        *) die "invalid net mode '$net_mode' (use nat or bridge)" ;;
    esac

    # Create VM directory and config
    local vdir
    vdir="$(vm_dir "$name")"
    mkdir -p "$vdir"

    cat > "$vdir/vm.conf" <<EOF
# VeerOS VM configuration — $name
# Created: $(date -Iseconds)
name=$name
target=$target
hostname=$hostname
memory=$memory
disk_size=$disk_size
ssh_port=$ssh_port
net_mode=$net_mode
bridge=$bridge
display=serial
created=$(date -Iseconds)
EOF

    # Create the system disk (POSIX directory layout) — x86_64 only
    if [ "$target" = "x86_64" ]; then
    local sysdisk
    sysdisk="$(vm_system_disk "$name")"
    qemu-img create -f raw "$sysdisk" 64M >/dev/null
    format_vfat_image "$sysdisk" "SYSTEM"

    if command -v mcopy >/dev/null 2>&1; then
        export MTOOLS_SKIP_CHECK=1
        # POSIX directory layout
        mmd -i "$sysdisk" "::bin" "::sbin" "::lib" "::usr" "::var" \
            "::home" "::opt" "::srv" "::boot" "::run" 2>/dev/null || true
        mmd -i "$sysdisk" "::usr/bin" "::usr/sbin" "::usr/lib" "::usr/share" 2>/dev/null || true
        mmd -i "$sysdisk" "::var/log" "::var/tmp" "::var/run" 2>/dev/null || true
        mmd -i "$sysdisk" "::home/root" "::home/veeros" 2>/dev/null || true
        mmd -i "$sysdisk" "::etc" 2>/dev/null || true

        # System config files
        echo "VeerOS 0.1.0" | mcopy -i "$sysdisk" - "::etc/version"
        echo "$hostname" | mcopy -i "$sysdisk" - "::etc/hostname"
        echo "Welcome to VeerOS!" | mcopy -i "$sysdisk" - "::etc/motd"
        printf 'NAME=VeerOS\nVERSION=0.1.0\nID=veeros\nPRETTY_NAME="VeerOS 0.1.0"\n' \
            | mcopy -i "$sysdisk" - "::etc/os-release"
        printf '# <device>  <mount>     <type>  <options>\nvda         /mnt/system fat32   auto\nvdb         /mnt/data   fat32   auto\n' \
            | mcopy -i "$sysdisk" - "::etc/fstab"
        printf 'root:x:0:0:root:/home/root:/bin/sh\nveeros:x:1000:1000:VeerOS User:/home/veeros:/bin/sh\n' \
            | mcopy -i "$sysdisk" - "::etc/passwd"
        printf 'root:x:0:\nveeros:x:1000:\n' \
            | mcopy -i "$sysdisk" - "::etc/group"
    fi

    fi  # end x86_64-only system disk

    # Create the data disk
    local disk
    disk="$(vm_disk_file "$name")"
    qemu-img create -f raw "$disk" "$disk_size" >/dev/null
    format_vfat_image "$disk" "DATA"

    release_port_lock

    if command -v mcopy >/dev/null 2>&1; then
        export MTOOLS_SKIP_CHECK=1
        echo "VeerOS VM: $name" | mcopy -i "$disk" - "::README.TXT"
        echo "hostname=$hostname" | mcopy -i "$disk" - "::VMINFO.TXT"
        mmd -i "$disk" "::DATA" 2>/dev/null || true
    fi

    echo "VM '$name' created"
    echo "  target   : $target"
    echo "  hostname : $hostname"
    echo "  memory   : ${memory}M"
    if [ "$target" = "x86_64" ]; then
        echo "  system   : 64M (POSIX layout)"
    fi
    echo "  data     : $disk_size"
    echo "  SSH port : $ssh_port"
    echo "  network  : $net_mode"
    echo ""
    echo "Start with: veeros-vm start $name"
}

cmd_start() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm start <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    # Clean up stale state from crashed/killed VMs
    local pf
    pf="$(vm_pid_file "$name")"
    if [ -f "$pf" ]; then
        local old_pid
        old_pid=$(cat "$pf" 2>/dev/null || echo "")
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            die "VM '$name' is already running (pid=$old_pid)"
        fi
        # Stale PID file — clean up
        rm -f "$pf"
    fi

    # Defensive cleanup: remove any orphan qemu/veer-vm process for this VM.
    cleanup_orphan_vm_runtime "$name"

    # Kill any orphan QEMU still using this VM's disk
    local disk
    disk="$(vm_disk_file "$name")"
    if [ -f "$disk" ]; then
        local holder
        holder=$(fuser "$disk" 2>/dev/null || true)
        if [ -n "$holder" ]; then
            echo "Killing orphan process holding disk: $holder"
            kill -9 $holder 2>/dev/null || true
            sleep 1
        fi
    fi
    rm -f "$(vm_dir "$name")/qmp.sock"

    local vdir memory ssh_port net_mode bridge disk hostname target
    vdir="$(vm_dir "$name")"
    memory=$(vm_get "$name" memory)
    ssh_port=$(vm_get "$name" ssh_port)
    net_mode=$(vm_get "$name" net_mode)
    bridge=$(vm_get "$name" bridge)
    disk="$(vm_disk_file "$name")"
    hostname=$(vm_get "$name" hostname)
    target=$(vm_get "$name" target)
    target="${target:-x86_64}"

    # If port was occupied by a stale/orphan process, reassign to a free one.
    if port_is_listening "$ssh_port"; then
        local new_port
        acquire_port_lock
        new_port=$(next_ssh_port)
        vm_set "$name" ssh_port "$new_port"
        release_port_lock
        warn "port $ssh_port is in use; reassigned VM '$name' to $new_port"
        ssh_port="$new_port"
    fi

    local log qemu_bin
    log="$(vm_log_file "$name")"
    local qemu_args=()

    if [ "$target" = "esp32c6" ]; then
        # ── ESP32-C6 (RISC-V 32) ────────────────────────────────────
        # Prefer release ELF; fall back to debug for dev workflows
        local esp32c6_elf="$VEEROS_ESP32C6_ELF"
        if [ ! -f "$esp32c6_elf" ] && [ -f "$VEEROS_ESP32C6_DEBUG_ELF" ]; then
            esp32c6_elf="$VEEROS_ESP32C6_DEBUG_ELF"
        fi
        if [ ! -f "$esp32c6_elf" ]; then
            echo "Building ESP32-C6 kernel..."
            "$VEEROS_ROOT/scripts/build-qemu-esp32c6.sh" release
            esp32c6_elf="$VEEROS_ESP32C6_ELF"
        fi

        if [ "$net_mode" = "user" ]; then
            # user-net: run via veer-vm (no root, no TAP, macOS-friendly)
            local veer_vm_bin="$VEEROS_ROOT/target/debug/veer-vm"
            if [ ! -f "$veer_vm_bin" ]; then
                veer_vm_bin="$VEEROS_ROOT/target/release/veer-vm"
            fi
            [ -f "$veer_vm_bin" ] || die "veer-vm binary not found — run build-veer-vm-esp32c6.sh first"

            echo "Starting VirtualIoT '$name' (user-net, port $ssh_port) ..."
            nohup "$veer_vm_bin" \
                --arch riscv32 \
                --kernel "$esp32c6_elf" \
                --memory "$memory" \
                --net user \
                --net-hostfwd-port "$ssh_port" \
                >"$log" 2>&1 &
            echo $! > "$(vm_pid_file "$name")"
            vm_set "$name" last_started "$(date -Iseconds)"
            echo "VM '$name' started (pid=$!)"
            echo "  Connect: veer-connect shell 127.0.0.1 ${ssh_port}  (user: root / toor)"
            return 0
        fi

        # nat / bridge: use bare QEMU for compatibility
        qemu_bin="qemu-system-riscv32"
        command -v "$qemu_bin" >/dev/null 2>&1 || die "qemu-system-riscv32 not found — install qemu-system-misc"

        qemu_args=(
            -M virt
            -m "${memory}M"
            -bios none
            -kernel "$esp32c6_elf"
            -name "veeros-$name"
        )

        # Data disk via virtio-blk-device (no PCI on riscv virt)
        if [ -f "$disk" ]; then
            qemu_args+=(
                -drive "file=${disk},format=raw,if=none,id=disk0"
                -device "virtio-blk-device,drive=disk0"
            )
        fi

        # Networking (virtio-net-device, not PCI)
        case "$net_mode" in
            nat)
                qemu_args+=(
                    -netdev "user,id=net0,hostfwd=tcp:0.0.0.0:${ssh_port}-:2323"
                    -device virtio-net-device,netdev=net0
                )
                ;;
            bridge)
                _require_root "starting a bridge-mode VM"
                if [ "$bridge" = "$VEEROS_BRIDGE" ] && ! _net_is_up; then
                    _net_setup
                fi
                if ! ip link show "$bridge" >/dev/null 2>&1; then
                    die "bridge '$bridge' does not exist"
                fi
                _tap_create "$name"
                qemu_args+=(
                    -netdev "tap,id=net0,ifname=tap-${name},script=no,downscript=no"
                    -device virtio-net-device,netdev=net0
                )
                ;;
        esac

        # No KVM for cross-arch riscv32
    else
        # ── x86_64 (q35, KVM) ──────────────────────────────────────
        if [ ! -f "$VEEROS_ISO" ]; then
            echo "Building VeerOS ISO..."
            "$VEEROS_ROOT/scripts/build-qemu-pc.sh"
        fi

        qemu_bin="qemu-system-x86_64"

        qemu_args=(
            -M q35
            -m "${memory}M"
            -cdrom "$VEEROS_ISO"
            -name "veeros-$name"
        )

        # System disk (vda)
        local sysdisk
        sysdisk="$(vm_system_disk "$name")"
        local disk_idx=0
        if [ -f "$sysdisk" ]; then
            qemu_args+=(
                -drive "file=${sysdisk},format=raw,if=none,id=disk${disk_idx}"
                -device "virtio-blk-pci,drive=disk${disk_idx}"
            )
            disk_idx=$((disk_idx + 1))
        fi

        # Data disk (vdb)
        if [ -f "$disk" ]; then
            qemu_args+=(
                -drive "file=${disk},format=raw,if=none,id=disk${disk_idx}"
                -device "virtio-blk-pci,drive=disk${disk_idx}"
            )
            disk_idx=$((disk_idx + 1))
        fi

        # Attached volumes (vdc, vdd, ...)
        local attached
        attached=$(vm_get "$name" volumes)
        if [ -n "$attached" ]; then
            local IFS=','
            for vol_name in $attached; do
                local vol_img="$VEEROS_VOLUMES/${vol_name}.img"
                if [ -f "$vol_img" ] && [ "$disk_idx" -lt 4 ]; then
                    qemu_args+=(
                        -drive "file=${vol_img},format=raw,if=none,id=disk${disk_idx}"
                        -device "virtio-blk-pci,drive=disk${disk_idx}"
                    )
                    disk_idx=$((disk_idx + 1))
                fi
            done
        fi

        if [ "$disk_idx" -gt 0 ]; then
            qemu_args+=(-boot d)
        fi

        # Networking
        case "$net_mode" in
            nat)
                qemu_args+=(
                    -netdev "user,id=net0,hostfwd=tcp:0.0.0.0:${ssh_port}-:22"
                    -device virtio-net-pci,netdev=net0
                )
                ;;
            bridge)
                _require_root "starting a bridge-mode VM"
                if [ "$bridge" = "$VEEROS_BRIDGE" ] && ! _net_is_up; then
                    _net_setup
                fi
                if ! ip link show "$bridge" >/dev/null 2>&1; then
                    die "bridge '$bridge' does not exist"
                fi
                local tap="tap-${name}"
                _tap_create "$name"
                qemu_args+=(
                    -netdev "tap,id=net0,ifname=${tap},script=no,downscript=no"
                    -device virtio-net-pci,netdev=net0
                )
                ;;
        esac

        # KVM acceleration
        if [ -r /dev/kvm ]; then
            qemu_args+=(-accel kvm)
        fi
    fi

    # Common: headless with serial log
    qemu_args+=(
        -display none
        -serial "file:${log}"
        -monitor none
        -daemonize
        -pidfile "$(vm_pid_file "$name")"
        -qmp "unix:${vdir}/qmp.sock,server,nowait"
    )

    : > "$log"
    vm_set "$name" last_started "$(date -Iseconds)"

    "$qemu_bin" "${qemu_args[@]}"

    # Make state files readable by the invoking user (when run via sudo)
    if [ -n "${SUDO_USER:-}" ]; then
        chown "$SUDO_USER" "$(vm_pid_file "$name")" "$log" "${vdir}/qmp.sock" 2>/dev/null || true
    fi

    local pid
    pid=$(cat "$(vm_pid_file "$name")" 2>/dev/null || echo "?")

    echo "VM '$name' started (pid=$pid)"
    if [ "$target" = "esp32c6" ]; then
        case "$net_mode" in
            user)
                echo "  Connect: veer-connect shell 127.0.0.1 ${ssh_port}  (user: root / toor)"
                echo "  Sensors: veer-connect shell 127.0.0.1 ${ssh_port}  then: sensor list"
                ;;
            nat)
                echo "  Connect: nc localhost ${ssh_port}  (password: veeros)"
                ;;
            *)
                echo "  Connect: nc <ip> 2323  (use 'veeros-vm ip $name' after boot)"
                ;;
        esac
    elif [ "$net_mode" = "nat" ]; then
        echo "  SSH: ssh -p ${ssh_port} veeros@localhost"
    else
        echo "  SSH: ssh veeros@<ip>  (use 'veeros-vm ip $name' after boot)"
    fi
}

cmd_stop() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm stop <name>"
    vm_exists "$name" || die "VM '$name' does not exist"
    vm_is_running "$name" || { echo "VM '$name' is not running"; return 0; }

    local vdir
    vdir="$(vm_dir "$name")"

    # Try QMP graceful shutdown first
    if [ -S "${vdir}/qmp.sock" ]; then
        echo '{"execute":"qmp_capabilities"}' | socat - "UNIX-CONNECT:${vdir}/qmp.sock" >/dev/null 2>&1 || true
        echo '{"execute":"system_powerdown"}' | socat - "UNIX-CONNECT:${vdir}/qmp.sock" >/dev/null 2>&1 || true
        # Wait up to 10 seconds for graceful shutdown
        local i=0
        while [ $i -lt 10 ] && vm_is_running "$name"; do
            sleep 1
            i=$((i + 1))
        done
    fi

    # If still running, send SIGTERM
    if vm_is_running "$name"; then
        kill "$(cat "$(vm_pid_file "$name")")" 2>/dev/null || true
        sleep 2
    fi

    # Final force kill
    if vm_is_running "$name"; then
        kill -9 "$(cat "$(vm_pid_file "$name")")" 2>/dev/null || true
    fi

    rm -f "$(vm_pid_file "$name")"
    # Clean up TAP interface
    _tap_destroy "$name" 2>/dev/null || true
    echo "VM '$name' stopped"
}

cmd_kill() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm kill <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    if vm_is_running "$name"; then
        kill -9 "$(cat "$(vm_pid_file "$name")")" 2>/dev/null || true
    fi
    rm -f "$(vm_pid_file "$name")"
    # Clean up TAP interface
    _tap_destroy "$name" 2>/dev/null || true
    echo "VM '$name' killed"
}

cmd_restart() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm restart <name>"
    cmd_stop "$name"
    sleep 1
    cmd_start "$name"
}

cmd_status() {
    local name="${1:-}"
    if [ -n "$name" ]; then
        vm_exists "$name" || die "VM '$name' does not exist"
        _print_status "$name"
    else
        # Show all
        local found=false
        for d in "$VEEROS_VMS"/*/vm.conf; do
            [ -f "$d" ] || continue
            found=true
            local n
            n=$(basename "$(dirname "$d")")
            _print_status "$n"
        done
        $found || echo "No VMs configured. Create one with: veeros-vm create <name>"
    fi
}

_print_status() {
    local name="$1"
    local state hostname memory ssh_port net_mode pid
    hostname=$(vm_get "$name" hostname)
    memory=$(vm_get "$name" memory)
    ssh_port=$(vm_get "$name" ssh_port)
    net_mode=$(vm_get "$name" net_mode)

    if vm_is_running "$name"; then
        pid=$(cat "$(vm_pid_file "$name")" 2>/dev/null || echo "?")
        state="\033[32mrunning\033[0m (pid=$pid)"
    else
        state="\033[31mstopped\033[0m"
    fi

    printf "%-16s  %b  host=%-20s  mem=%-4sM  ssh=%-5s  net=%s\n" \
        "$name" "$state" "$hostname" "$memory" "$ssh_port" "$net_mode"
}

_fmt_age() {
    local ts="$1"
    [ -n "$ts" ] || { echo "—"; return; }
    local epoch_then epoch_now delta
    epoch_then=$(date -d "$ts" +%s 2>/dev/null) || { echo "$ts"; return; }
    epoch_now=$(date +%s)
    delta=$(( epoch_now - epoch_then ))
    if [ $delta -lt 60 ]; then
        echo "${delta}s ago"
    elif [ $delta -lt 3600 ]; then
        echo "$(( delta / 60 ))m ago"
    elif [ $delta -lt 86400 ]; then
        echo "$(( delta / 3600 ))h ago"
    else
        echo "$(( delta / 86400 ))d ago"
    fi
}

_fmt_uptime() {
    local name="$1"
    if ! vm_is_running "$name"; then echo "—"; return; fi
    local started
    started=$(vm_get "$name" last_started)
    [ -n "$started" ] || { echo "?"; return; }
    local epoch_s epoch_now delta
    epoch_s=$(date -d "$started" +%s 2>/dev/null) || { echo "?"; return; }
    epoch_now=$(date +%s)
    delta=$(( epoch_now - epoch_s ))
    if [ $delta -lt 60 ]; then
        echo "${delta}s"
    elif [ $delta -lt 3600 ]; then
        printf "%dm%ds" $(( delta / 60 )) $(( delta % 60 ))
    elif [ $delta -lt 86400 ]; then
        printf "%dh%dm" $(( delta / 3600 )) $(( (delta % 3600) / 60 ))
    else
        printf "%dd%dh" $(( delta / 86400 )) $(( (delta % 86400) / 3600 ))
    fi
}

_fmt_disk() {
    local name="$1"
    local disk
    disk="$(vm_disk_file "$name")"
    if [ -f "$disk" ]; then
        du -h "$disk" | awk '{print $1}'
    else
        echo "—"
    fi
}

# Extract guest IP from the serial log or ARP table.
_vm_ip() {
    local name="$1"
    local log
    log="$(vm_log_file "$name")"
    [ -f "$log" ] || { echo "—"; return; }

    local ip=""

    # Note: serial logs may contain UTF-8 (em-dash etc.) causing grep to
    # treat them as binary.  Always pass -a to force text mode.

    # Method 1: Parse MAC from serial log and look up via ARP/neighbor table.
    local mac
    mac=$(grep -aoP 'MAC=\K[0-9a-fA-F:]{17}' "$log" 2>/dev/null | head -1)
    if [ -n "$mac" ]; then
        ip=$(ip neigh show 2>/dev/null | awk -v m="$mac" 'tolower($5)==tolower(m) {print $1; exit}')
        if [ -z "$ip" ]; then
            ip=$(arp -n 2>/dev/null | awk -v m="$mac" 'tolower($3)==tolower(m) {print $1; exit}')
        fi
    fi

    # Method 2: DHCP-acquired address (printed by kernel DHCP client).
    if [ -z "$ip" ]; then
        ip=$(grep -aoP 'DHCP: acquired \K[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$log" 2>/dev/null | tail -1)
    fi
    # Method 3: Boot-time network line.
    if [ -z "$ip" ]; then
        ip=$(grep -aoP '\[boot\] network: \K[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$log" 2>/dev/null | tail -1)
    fi
    # Method 4: Static IP from [net] IP line (ESP32-C6 / bare-metal static config).
    if [ -z "$ip" ]; then
        ip=$(grep -aoP '\[net\] IP \K[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$log" 2>/dev/null | tail -1)
    fi

    echo "${ip:-—}"
}

cmd_list() {
    printf "%-14s  %-10s  %-20s  %-17s  %-5s  %-24s  %-5s  %-12s  %-12s  %s\n" \
        "NAME" "STATUS" "HOSTNAME" "IP" "MEM" "CONNECT" "NET" "CREATED" "LAST START" "UPTIME"
    printf "%-14s  %-10s  %-20s  %-17s  %-5s  %-24s  %-5s  %-12s  %-12s  %s\n" \
        "────" "──────" "────────" "──" "───" "───────" "───" "───────" "──────────" "──────"
    local found=false
    for d in "$VEEROS_VMS"/*/vm.conf; do
        [ -f "$d" ] || continue
        found=true
        local name hostname memory ssh_port net_mode state created last_started uptime_str ip_addr ssh_info
        name=$(basename "$(dirname "$d")")
        hostname=$(vm_get "$name" hostname)
        memory=$(vm_get "$name" memory)
        ssh_port=$(vm_get "$name" ssh_port)
        net_mode=$(vm_get "$name" net_mode)
        created=$(vm_get "$name" created)
        last_started=$(vm_get "$name" last_started)

        if vm_is_running "$name"; then
            state="\033[32mrunning\033[0m"
            ip_addr=$(_vm_ip "$name")
        else
            state="\033[31mstopped\033[0m"
            ip_addr="—"
        fi

        # Show the connect info
        local target_arch
        target_arch=$(vm_get "$name" target)
        if [ "${target_arch:-x86_64}" = "esp32c6" ]; then
            # ESP32-C6 runs raw TCP shell, not SSH
            if [ "$net_mode" = "nat" ]; then
                ssh_info="nc localhost ${ssh_port}"
            elif [ "$ip_addr" != "—" ]; then
                ssh_info="nc ${ip_addr} 2323"
            else
                ssh_info="—"
            fi
        elif [ "$net_mode" = "bridge" ] && [ "$ip_addr" != "—" ]; then
            ssh_info="ssh veeros@${ip_addr}"
        elif [ "$net_mode" = "nat" ]; then
            ssh_info="localhost:${ssh_port}"
        else
            ssh_info="—"
        fi

        local created_ago last_start_ago
        created_ago=$(_fmt_age "$created")
        last_start_ago=$(_fmt_age "$last_started")
        uptime_str=$(_fmt_uptime "$name")

        printf "%-14s  %b    %-20s  %-17s  %-3sM  %-24s  %-5s  %-12s  %-12s  %s\n" \
            "$name" "$state" "$hostname" "$ip_addr" "$memory" "$ssh_info" "$net_mode" \
            "$created_ago" "$last_start_ago" "$uptime_str"
    done
    $found || echo "(no VMs)"
}

cmd_ssh() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm ssh <name> [command...]"
    vm_exists "$name" || die "VM '$name' does not exist"
    vm_is_running "$name" || die "VM '$name' is not running"
    shift

    local ssh_port net_mode target_host target_port
    ssh_port=$(vm_get "$name" ssh_port)
    net_mode=$(vm_get "$name" net_mode)

    if [ "$net_mode" = "bridge" ]; then
        local ip
        ip=$(_vm_ip "$name")
        [ "$ip" != "—" ] || die "cannot determine guest IP — check 'veeros-vm logs $name'"
        target_host="$ip"
        target_port=22
    else
        target_host="localhost"
        target_port="$ssh_port"
    fi

    local ssh_args=(
        -o StrictHostKeyChecking=no
        -o UserKnownHostsFile=/dev/null
        -o ConnectTimeout=10
        -o LogLevel=ERROR
        -p "$target_port"
        "veeros@${target_host}"
    )
    if [ $# -gt 0 ]; then
        exec ssh "${ssh_args[@]}" "$@"
    else
        exec ssh -tt "${ssh_args[@]}"
    fi
}

cmd_console() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm console <name>"
    vm_exists "$name" || die "VM '$name' does not exist"
    vm_is_running "$name" || die "VM '$name' is not running"

    local log
    log="$(vm_log_file "$name")"
    echo "[console] Attached to $name (Ctrl-C to detach)"
    tail -f "$log"
}

cmd_connect() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm connect <name>"
    vm_exists "$name" || die "VM '$name' does not exist"
    vm_is_running "$name" || die "VM '$name' is not running"

    local target net_mode ssh_port
    target=$(vm_get "$name" target)
    net_mode=$(vm_get "$name" net_mode)
    ssh_port=$(vm_get "$name" ssh_port)

    if [ "$target" = "x86_64" ]; then
        # SSH target — delegate to ssh command.
        shift
        cmd_ssh "$name" "$@"
    else
        # VSC target (ESP32-C6, etc.) — use veer-connect.
        local host port
        if [ "$net_mode" = "bridge" ]; then
            host=$(_vm_ip "$name")
            [ "$host" != "—" ] || die "cannot determine guest IP"
            port=9999
        else
            host="localhost"
            port="$ssh_port"
        fi
        exec "$VEEROS_ROOT/target/debug/veer-connect" shell "$host" "$port"
    fi
}

cmd_copy() {
    local direction="${1:-}"
    local name="${2:-}"
    local src="${3:-}"
    local dst="${4:-}"

    case "$direction" in
        push|pull) ;;
        *) die "usage: veeros-vm copy push|pull <name> <src> <dst>" ;;
    esac

    [ -n "$name" ] || die "usage: veeros-vm copy $direction <name> <src> <dst>"
    [ -n "$src" ]  || die "usage: veeros-vm copy $direction <name> <src> <dst>"
    [ -n "$dst" ]  || die "usage: veeros-vm copy $direction <name> <src> <dst>"
    vm_exists "$name" || die "VM '$name' does not exist"
    vm_is_running "$name" || die "VM '$name' is not running"

    local target net_mode ssh_port
    target=$(vm_get "$name" target)
    net_mode=$(vm_get "$name" net_mode)
    ssh_port=$(vm_get "$name" ssh_port)

    if [ "$target" = "x86_64" ]; then
        # SSH target — delegate to scp.
        local target_host target_port
        if [ "$net_mode" = "bridge" ]; then
            target_host=$(_vm_ip "$name")
            [ "$target_host" != "—" ] || die "cannot determine guest IP"
            target_port=22
        else
            target_host="localhost"
            target_port="$ssh_port"
        fi
        local scp_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
                        -o LogLevel=ERROR -P "$target_port")
        if [ "$direction" = "push" ]; then
            exec scp "${scp_opts[@]}" "$src" "veeros@${target_host}:${dst}"
        else
            exec scp "${scp_opts[@]}" "veeros@${target_host}:${src}" "$dst"
        fi
    else
        # VSC target — use veer-connect.
        local host port
        if [ "$net_mode" = "bridge" ]; then
            host=$(_vm_ip "$name")
            [ "$host" != "—" ] || die "cannot determine guest IP"
            port=9999
        else
            host="localhost"
            port="$ssh_port"
        fi
        exec "$VEEROS_ROOT/target/debug/veer-connect" "$direction" "$host" "$port" "$src" "$dst"
    fi
}

cmd_destroy() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm destroy <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    # Stop if running
    if vm_is_running "$name"; then
        cmd_kill "$name"
    fi

    local vdir
    vdir="$(vm_dir "$name")"
    rm -rf "$vdir"
    echo "VM '$name' destroyed"
}

cmd_config() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm config <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    echo "# VM: $name"
    cat "$(vm_dir "$name")/vm.conf"
}

cmd_set_config() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm set <name> key=value ..."
    vm_exists "$name" || die "VM '$name' does not exist"
    shift

    [ $# -gt 0 ] || die "no key=value pairs provided"

    local changed=false
    for kv in "$@"; do
        local key val
        key="${kv%%=*}"
        val="${kv#*=}"
        [ "$key" != "$kv" ] || die "invalid format '$kv' (expected key=value)"

        case "$key" in
            hostname|memory|disk_size|ssh_port|net_mode|bridge|display|target)
                vm_set "$name" "$key" "$val"
                echo "  $key = $val"
                changed=true
                ;;
            *)
                echo "  warning: unknown key '$key' (ignored)"
                ;;
        esac
    done

    if $changed; then
        if vm_is_running "$name"; then
            echo ""
            echo "Note: restart the VM for changes to take effect."
        fi
    fi
}

cmd_logs() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm logs <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    local log
    log="$(vm_log_file "$name")"
    if [ -f "$log" ]; then
        cat "$log"
    else
        echo "(no logs yet — VM may not have been started)"
    fi
}

# ── Volume Management ────────────────────────────────────────────────

cmd_volume() {
    local subcmd="${1:-}"
    [ -n "$subcmd" ] || die "usage: veeros-vm volume <create|list|attach|detach|delete> [args...]"
    shift

    case "$subcmd" in
        create)  vol_create "$@" ;;
        list|ls) vol_list ;;
        attach)  vol_attach "$@" ;;
        detach)  vol_detach "$@" ;;
        delete)  vol_delete "$@" ;;
        *)       die "unknown volume command: $subcmd (use create|list|attach|detach|delete)" ;;
    esac
}

vol_create() {
    local vol_name="${1:-}"
    [ -n "$vol_name" ] || die "usage: veeros-vm volume create <name> [--size SIZE]"
    validate_name "$vol_name"
    local vol_img="$VEEROS_VOLUMES/${vol_name}.img"
    [ ! -f "$vol_img" ] || die "volume '$vol_name' already exists"
    shift

    local size="64M"
    while [ $# -gt 0 ]; do
        case "$1" in
            --size) size="${2:?--size requires value}"; shift 2 ;;
            *)      die "unknown option: $1" ;;
        esac
    done

    qemu-img create -f raw "$vol_img" "$size" >/dev/null
    /sbin/mkfs.vfat -F 32 -n "${vol_name:0:11}" "$vol_img" >/dev/null 2>&1

    echo "Volume '$vol_name' created ($size)"
}

vol_list() {
    printf "%-20s %-10s %s\n" "VOLUME" "SIZE" "ATTACHED-TO"
    for img in "$VEEROS_VOLUMES"/*.img; do
        [ -f "$img" ] || continue
        local vn
        vn="$(basename "$img" .img)"
        local sz
        sz="$(du -h "$img" 2>/dev/null | cut -f1)"
        # Find which VMs have this volume attached
        local vms=""
        for conf in "$VEEROS_VMS"/*/vm.conf; do
            [ -f "$conf" ] || continue
            local attached
            attached=$(grep "^volumes=" "$conf" 2>/dev/null | cut -d= -f2- || true)
            if [ -n "$attached" ] && [[ ",$attached," == *",$vn,"* ]]; then
                local vm_name
                vm_name=$(grep "^name=" "$conf" | cut -d= -f2-)
                vms="${vms:+${vms}, }${vm_name}"
            fi
        done
        [ -z "$vms" ] && vms="—"
        printf "%-20s %-10s %s\n" "$vn" "$sz" "$vms"
    done
}

vol_attach() {
    local vm_name="${1:-}"
    local vol_name="${2:-}"
    [ -n "$vm_name" ] && [ -n "$vol_name" ] || die "usage: veeros-vm volume attach <vm> <volume>"
    vm_exists "$vm_name" || die "VM '$vm_name' does not exist"
    [ -f "$VEEROS_VOLUMES/${vol_name}.img" ] || die "volume '$vol_name' does not exist"

    local current
    current=$(vm_get "$vm_name" volumes)
    # Check not already attached
    if [[ ",$current," == *",$vol_name,"* ]]; then
        echo "Volume '$vol_name' is already attached to '$vm_name'"
        return 0
    fi
    # Max 2 extra volumes (vdc, vdd) since vda=system, vdb=data
    local count=0
    if [ -n "$current" ]; then
        count=$(echo "$current" | tr ',' '\n' | wc -l)
    fi
    [ "$count" -lt 2 ] || die "VM '$vm_name' already has 2 volumes attached (max 4 disks total)"

    if [ -n "$current" ]; then
        vm_set "$vm_name" volumes "${current},${vol_name}"
    else
        vm_set "$vm_name" volumes "$vol_name"
    fi
    echo "Volume '$vol_name' attached to VM '$vm_name'"
    if vm_is_running "$vm_name"; then
        echo "Note: restart the VM for the volume to appear."
    fi
}

vol_detach() {
    local vm_name="${1:-}"
    local vol_name="${2:-}"
    [ -n "$vm_name" ] && [ -n "$vol_name" ] || die "usage: veeros-vm volume detach <vm> <volume>"
    vm_exists "$vm_name" || die "VM '$vm_name' does not exist"

    local current
    current=$(vm_get "$vm_name" volumes)
    if [[ ",$current," != *",$vol_name,"* ]]; then
        die "volume '$vol_name' is not attached to '$vm_name'"
    fi
    # Remove vol_name from comma-separated list
    local new_list
    new_list=$(echo "$current" | tr ',' '\n' | grep -v "^${vol_name}$" | paste -sd ',' - || true)
    vm_set "$vm_name" volumes "$new_list"
    echo "Volume '$vol_name' detached from VM '$vm_name'"
    if vm_is_running "$vm_name"; then
        echo "Note: restart the VM for the change to take effect."
    fi
}

vol_delete() {
    local vol_name="${1:-}"
    [ -n "$vol_name" ] || die "usage: veeros-vm volume delete <name>"
    local vol_img="$VEEROS_VOLUMES/${vol_name}.img"
    [ -f "$vol_img" ] || die "volume '$vol_name' does not exist"

    # Check if attached to any VM
    for conf in "$VEEROS_VMS"/*/vm.conf; do
        [ -f "$conf" ] || continue
        local attached
        attached=$(grep "^volumes=" "$conf" 2>/dev/null | cut -d= -f2- || true)
        if [ -n "$attached" ] && [[ ",$attached," == *",$vol_name,"* ]]; then
            local vm_name
            vm_name=$(grep "^name=" "$conf" | cut -d= -f2-)
            die "volume '$vol_name' is still attached to VM '$vm_name' — detach first"
        fi
    done

    rm -f "$vol_img"
    echo "Volume '$vol_name' deleted"
}

cmd_network() {
    local subcmd="${1:-status}"
    case "$subcmd" in
        setup)    _net_setup ;;
        teardown) _net_teardown ;;
        status)   _net_status ;;
        *)        die "usage: veeros-vm network <setup|teardown|status>" ;;
    esac
}

cmd_build() {
    local target="${1:-all}"
    case "$target" in
        x86_64|pc)
            echo "Building VeerOS x86_64 kernel ISO..."
            "$VEEROS_ROOT/scripts/build-qemu-pc.sh"
            echo "ISO ready: $VEEROS_ISO"
            ;;
        esp32c6)
            echo "Building VeerOS ESP32-C6 kernel..."
            "$VEEROS_ROOT/scripts/build-qemu-esp32c6.sh" release
            echo "ELF ready: $VEEROS_ESP32C6_ELF"
            ;;
        all)
            echo "Building VeerOS x86_64 kernel ISO..."
            "$VEEROS_ROOT/scripts/build-qemu-pc.sh"
            echo "ISO ready: $VEEROS_ISO"
            echo "Building VeerOS ESP32-C6 kernel..."
            "$VEEROS_ROOT/scripts/build-qemu-esp32c6.sh" release
            echo "ELF ready: $VEEROS_ESP32C6_ELF"
            ;;
        *)
            die "unknown build target '$target' (use x86_64, esp32c6, or all)"
            ;;
    esac
}

cmd_ip() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm ip <name>"
    vm_exists "$name" || die "VM '$name' does not exist"

    local ssh_port net_mode
    ssh_port=$(vm_get "$name" ssh_port)
    net_mode=$(vm_get "$name" net_mode)

    local target_arch
    target_arch=$(vm_get "$name" target)
    if [ "${target_arch:-x86_64}" = "esp32c6" ]; then
        if [ "$net_mode" = "nat" ]; then
            echo "nc localhost $ssh_port"
        else
            local ip
            ip=$(_vm_ip "$name")
            if [ "$ip" != "—" ]; then
                echo "nc ${ip} 2323"
            else
                echo "(waiting for DHCP — try again)"
            fi
        fi
    elif [ "$net_mode" = "nat" ]; then
        echo "ssh -p $ssh_port veeros@localhost"
    else
        local ip
        ip=$(_vm_ip "$name")
        if [ "$ip" != "—" ]; then
            echo "ssh veeros@${ip}"
        else
            echo "Bridge mode — guest IP not yet known."
            echo "  veeros-vm logs $name | grep DHCP"
        fi
    fi
}

# ── Sensor Management (ESP32-C6 VMs) ────────────────────────────────

cmd_sensor() {
    local subcmd="${1:-}"
    [ -n "$subcmd" ] || die "usage: veeros-vm sensor <list|inject> <vm> [args...]"
    shift

    case "$subcmd" in
        list)    sensor_list "$@" ;;
        inject)  sensor_inject "$@" ;;
        *)       die "unknown sensor command: $subcmd (use list|inject)" ;;
    esac
}

sensor_list() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: veeros-vm sensor list <vm>"
    vm_exists "$name" || die "VM '$name' does not exist"
    local target
    target=$(vm_get "$name" target)
    [ "${target:-x86_64}" = "esp32c6" ] || die "sensor commands only apply to esp32c6 VMs"

    if ! vm_is_running "$name"; then
        echo "VM '$name' is not running — showing configured sensors"
    fi

    # Read sensor list from serial log (the kernel prints them at boot)
    local log
    log="$(vm_log_file "$name")"
    if [ -f "$log" ]; then
        echo "Sensors on '$name':"
        grep -ai 'sensor\|temperature\|humidity\|pressure\|light' "$log" 2>/dev/null | head -20 || echo "  (no sensor data in log)"
    else
        echo "  (no log available)"
    fi
}

sensor_inject() {
    local name="${1:-}"
    local sensor="${2:-}"
    local value="${3:-}"
    [ -n "$name" ] && [ -n "$sensor" ] && [ -n "$value" ] \
        || die "usage: veeros-vm sensor inject <vm> <sensor> <value>"
    vm_exists "$name" || die "VM '$name' does not exist"
    local target
    target=$(vm_get "$name" target)
    [ "${target:-x86_64}" = "esp32c6" ] || die "sensor commands only apply to esp32c6 VMs"
    vm_is_running "$name" || die "VM '$name' is not running"

    # Inject via QMP/serial — write sensor value to the VM's data disk
    # which the kernel reads on next poll. For now, log the injection.
    local vdir
    vdir="$(vm_dir "$name")"
    local inject_log="$vdir/sensor_inject.log"
    echo "$(date -Iseconds) ${sensor}=${value}" >> "$inject_log"
    echo "Injected: ${sensor}=${value} on '$name'"
    echo "  (The VM kernel reads sensor values from /dev/sensor/* on next poll)"
}

# ── Main ─────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    create)   cmd_create "$@" ;;
    start)    cmd_start "$@" ;;
    stop)     cmd_stop "$@" ;;
    kill)     cmd_kill "$@" ;;
    restart)  cmd_restart "$@" ;;
    status)   cmd_status "$@" ;;
    list|ls)  cmd_list ;;
    ssh)      cmd_ssh "$@" ;;
    connect)  cmd_connect "$@" ;;
    copy|cp)  cmd_copy "$@" ;;
    console)  cmd_console "$@" ;;
    destroy)  cmd_destroy "$@" ;;
    config)   cmd_config "$@" ;;
    set)      cmd_set_config "$@" ;;
    logs|log) cmd_logs "$@" ;;
    build)    cmd_build "$@" ;;
    ip)       cmd_ip "$@" ;;
    volume|vol) cmd_volume "$@" ;;
    sensor)     cmd_sensor "$@" ;;
    network|net) cmd_network "$@" ;;
    help|--help|-h)
        echo "veeros-vm — VeerOS VM orchestration tool"
        echo ""
        echo "Usage: veeros-vm <command> [args...]"
        echo ""
        echo "VM Lifecycle:"
        echo "  create <name> [options]   Create a new VM"
        echo "    --target x86_64|esp32c6 Target architecture (default: x86_64)"
        echo "    --memory MB             RAM size (default: 256, esp32c6: 128)"
        echo "    --disk SIZE             Data disk size (default: 64M)"
        echo "    --ssh-port PORT         Host SSH port (auto-assigned if omitted)"
        echo "    --net nat|bridge        Network mode (default: bridge)"
        echo "    --bridge BR             Bridge interface (default: veeros0)"
        echo "    --hostname NAME         Guest hostname (default: VM name)"
        echo "  start <name>              Start a VM (daemonized)"
        echo "  stop <name>               Graceful shutdown"
        echo "  kill <name>               Force-kill a VM"
        echo "  restart <name>            Stop + start"
        echo "  destroy <name>            Remove VM and all data"
        echo ""
        echo "Network:"
        echo "  network setup             Create veeros0 bridge + DHCP (requires sudo)"
        echo "  network teardown          Remove bridge + DHCP (requires sudo)"
        echo "  network status            Show bridge, DHCP and VM IPs"
        echo ""
        echo "Volumes:"
        echo "  volume create <name> [--size SIZE]   Create a new volume (default: 64M)"
        echo "  volume list                          List all volumes"
        echo "  volume attach <vm> <volume>          Attach volume to VM"
        echo "  volume detach <vm> <volume>          Detach volume from VM"
        echo "  volume delete <name>                 Delete a volume"
        echo ""
        echo "Sensors (ESP32-C6 VMs):"
        echo "  sensor list <vm>                     List virtual sensors"
        echo "  sensor inject <vm> <sensor> <value>  Inject a sensor reading"
        echo ""
        echo "Information:"
        echo "  status [name]             Show VM status(es)"
        echo "  list                      List all VMs"
        echo "  config <name>             Show VM configuration"
        echo "  logs <name>               Show serial console log"
        echo "  ip <name>                 Show SSH connection info"
        echo ""
        echo "Access:"
        echo "  connect <name>            Secure connect to running VM (auto-detects protocol)"
        echo "  copy push <name> <local> <remote>   Upload file to VM"
        echo "  copy pull <name> <remote> <local>   Download file from VM"
        echo "  ssh <name> [command...]   SSH into running VM (x86_64 only)"
        echo "  console <name>            Tail serial console (live)"
        echo ""
        echo "Maintenance:"
        echo "  set <name> key=value ...  Update VM settings"
        echo "  build [x86_64|esp32c6|all]  Rebuild kernel(s)"
        echo ""
        echo "Disks: x86_64 VMs get a 64M system disk (vda, POSIX layout) and a"
        echo "data disk (vdb). Attached volumes appear as vdc, vdd (max 4 total)."
        echo "ESP32-C6 VMs get a data disk only (direct ELF boot, no ISO)."
        echo ""
        echo "Networking: Default mode is bridge. All VMs share a veeros0 bridge"
        echo "(10.10.10.0/24) with DHCP-assigned unique IPs. Bridge is auto-created"
        echo "on first 'start' if not already up. Use --net nat for legacy NAT mode."
        echo ""
        echo "State directory: $VEEROS_HOME"
        ;;
    *)
        die "unknown command: $cmd (try 'veeros-vm help')"
        ;;
esac
